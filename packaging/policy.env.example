# Viga multi-user broker policy (root-owned).
# Installed to: /Library/Application Support/Viga/policy.env
# Edited by the menu-bar app after admin authentication. Re-read per connection,
# so changes take effect without restarting the broker.

# The account that always gets the full console treatment (its own virtual
# display, dynamic resolution, HiDPI, audio). Everyone else is served the
# native framebuffer of their background session, scaled to the client size.
# Leave blank for "no designated primary".
PRIMARY_USER=

# Master switch. 0 = single-user: only PRIMARY_USER (or, if unset, whoever is on
# the console) is served; other users are turned away with a reason.
# 1 = multi-user: additional users get their own background sessions.
MULTI_USER=0

# Optional comma/space-separated allow-list of local accounts permitted to
# connect at all. Blank = any account that passes PAM in the session agent.
ALLOWED_USERS=
