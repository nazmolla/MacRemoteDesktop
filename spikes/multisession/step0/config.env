# Step-0 proof config: native-framebuffer capture inside a BACKGROUND session.
# Deliberately NO virtual display (VIRTUAL_DISPLAY unset, DISPLAY_HOST=0) so Viga
# mirrors the session's real primary display — the one thing that works in a
# background session without the SkyLight entitlement (Jump's model).
BIND=0.0.0.0:3392
SKIP_AUTH=1
DISPLAY_HOST=0
ENABLE_H264=1
RUST_LOG=info,macrdp::capture=debug
LOG_DIR=/Users/Shared/vigatest
